# Aagasa Worker configuration example. Copy, fill in, and keep out of git.
# Hardware values are explicit on purpose: nothing here should be guessed.

AAGASA_LOG_LEVEL=info

# The Server resolves the identifiers from this name during registration.
AAGASA_WORKER_NAME=worker-1

AAGASA_SERVER_GRPC_ADDRESS=127.0.0.1:9090
AAGASA_SERVER_TLS_ENABLED=false

# Must match the Server's AAGASA_WORKER_SHARED_SECRET. At least 32 characters.
AAGASA_WORKER_SHARED_SECRET=CHANGE_ME

AAGASA_STATE_DIR=./data/state
AAGASA_RECORDINGS_DIR=./data/recordings

AAGASA_ROTATOR_SERIAL_PORT=/dev/ttyUSB0
AAGASA_ROTATOR_BAUD_RATE=9600
# Safe position the rotator is driven to at startup and shutdown.
# Azimuth 0-359, elevation 0-90 (the G-550 limits).
AAGASA_ROTATOR_PARK_AZIMUTH=0
AAGASA_ROTATOR_PARK_ELEVATION=0

# Zero-based index of the RTL-SDR to use. V1 supports one radio.
AAGASA_SDR_DEVICE_INDEX=0
AAGASA_RTL_TEST_BIN=rtl_test

AAGASA_SATDUMP_BIN=satdump
# Leave unset to search the standard SatDump pipeline locations.
# The container image uses /opt/satdump-runtime/resources/pipelines.
AAGASA_SATDUMP_PIPELINES_DIR=/opt/satdump-runtime/resources/pipelines
# SatDump 2.x moved the old live/record commands under `legacy`.
AAGASA_SATDUMP_LEGACY_CLI=true

AAGASA_HEARTBEAT_INTERVAL_SECONDS=5
