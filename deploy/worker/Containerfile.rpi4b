FROM docker.io/dhritvanspacelab/satdump:rpi4b
ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /app
COPY --from=ghcr.io/astral-sh/uv:0.13.10 /uv /usr/local/bin/uv
COPY worker /app
ENV UV_PYTHON_INSTALL_DIR=/opt/python
RUN uv sync --frozen --no-dev
RUN apt-get update && apt-get install -y --no-install-recommends sqlite3 && mkdir -p /root/.config/satdump \
    && sqlite3 /root/.config/satdump/main.db "\
CREATE TABLE IF NOT EXISTS meta(id TEXT PRIMARY KEY NOT NULL,val TEXT NOT NULL); \
CREATE TABLE IF NOT EXISTS user(id TEXT PRIMARY KEY NOT NULL,val TEXT NOT NULL); \
CREATE TABLE IF NOT EXISTS kepler(satellite_number INT NOT NULL,element_number INT NOT NULL,name TEXT NOT NULL,designator TEXT NOT NULL,epoch REAL NOT NULL,inclination REAL NOT NULL,right_ascension REAL NOT NULL,eccentricity REAL NOT NULL,argument_of_perigee REAL NOT NULL,mean_anomaly REAL NOT NULL,mean_motion REAL NOT NULL,derivative_mean_motion REAL NOT NULL,second_derivative_mean_motion REAL NOT NULL,bstar_drag_term REAL NOT NULL,revolutions_at_epoch INT NOT NULL); \
CREATE TABLE IF NOT EXISTS iers(time INT PRIMARY KEY NOT NULL,a_pole_x FLOAT NOT NULL,a_pole_y FLOAT NOT NULL,ut1_utc FLOAT NOT NULL); \
CREATE TABLE IF NOT EXISTS leap_seconds(time INT PRIMARY KEY NOT NULL,leap_seconds INT NOT NULL); \
INSERT OR REPLACE INTO meta(id,val) VALUES('iers_last_updated','4102444800'),('iers_last_update','4102444800'); \
WITH RECURSIVE seq(mjd) AS (SELECT 58000 UNION ALL SELECT mjd+1 FROM seq WHERE mjd < 70000) \
INSERT OR REPLACE INTO iers(time,a_pole_x,a_pole_y,ut1_utc) SELECT mjd,0.05,0.35,-0.05 FROM seq; \
INSERT OR REPLACE INTO leap_seconds(time,leap_seconds) VALUES(57754,37);" \
    && rm -rf /var/lib/apt/lists/*
ENV LD_LIBRARY_PATH=/usr/local/lib/satdump/plugins
ENV PATH="/app/.venv/bin:$PATH"
WORKDIR /opt/satdump-runtime
CMD ["aagasa-worker"]
