[Unit]
Description=Aagasa Server (control plane)
After=network-online.target
Wants=network-online.target

Requires=aagasa-databases.service
After=aagasa-databases.service

StartLimitIntervalSec=0

[Kube]
Yaml=/etc/containers/systemd/server.yaml

[Service]
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
