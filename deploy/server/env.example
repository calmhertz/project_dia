# Aagasa Server configuration example. Copy, fill in, and keep out of git.
# Secrets belong in Podman secrets in a real deployment, not in a file.

AAGASA_ENV=development
AAGASA_LOG_LEVEL=info

AAGASA_HTTP_ADDRESS=:8080
AAGASA_GRPC_ADDRESS=:9090

AAGASA_POSTGRES_URL=postgres://aagasa:CHANGE_ME@127.0.0.1:5432/aagasa
AAGASA_REDIS_URL=redis://127.0.0.1:6379/0
AAGASA_MONGO_URL=mongodb://127.0.0.1:27017
AAGASA_MONGO_DATABASE=aagasa

AAGASA_PREDICTION_ADDRESS=127.0.0.1:9091

# TLE providers. Leave empty to use the verified default endpoints:
#   CelesTrak https://celestrak.org/NORAD/elements/gp.php
#   SatNOGS   https://db.satnogs.org/api
# Any CelesTrak-compatible gp.php endpoint works here, for example the
# rate-limit-friendly mirror https://www.orbicentral.net/gp.php
AAGASA_CELESTRAK_URL=
AAGASA_SATNOGS_URL=
# Background 24-hour TLE refresh. Disable only for an air-gapped deployment.
AAGASA_TLE_REFRESH_ENABLED=true

# Large binary content. Metadata stays in the database.
AAGASA_RECORDINGS_DIR=./data/recordings
AAGASA_PIPELINES_DIR=./data/pipelines
# Built Flutter client (client/build/web), served at the root of :8080.
AAGASA_WEB_DIR=./deploy/server/web

# Shared secret the Worker presents. At least 32 characters.
# Generate with: openssl rand -hex 32
AAGASA_WORKER_SHARED_SECRET=CHANGE_ME

AAGASA_STARTUP_TIMEOUT=10

# Session lifetime in seconds. Default 12 hours.
AAGASA_SESSION_TTL=43200
