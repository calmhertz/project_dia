# Aagasa
#
# Two rules decide what is here: anything that is generated, and anything that
# is a credential. Generated code and build output belong to whoever builds;
# credentials belong nowhere in a repository at all.

# Credentials and local configuration ---------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.csr
*.p12
*.pfx
# deploy/*/env.example is committed; a real env file next to it is not.
deploy/**/env
deploy/**/*.env
secrets.yaml
*-secrets.yaml

# Generated protobuf code ----------------------------------------------------
# Regenerated with `make proto`; committing it means two sources of truth.
*.pb.go
*_grpc.pb.go
*_pb2.py
*_pb2_grpc.py
*_pb2.pyi
/server/go/internal/gen/
/server/python/src/aagasa/
/worker/src/aagasa/

# Go -------------------------------------------------------------------------
/server/go/bin/
*.test
*.out
coverage.txt

# Python ---------------------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
dist/

# Flutter and Dart -----------------------------------------------------------
# pubspec.lock and uv.lock ARE committed: an application pins its dependencies.
/client/build/
/client/.dart_tool/
/client/.flutter-plugins
/client/.flutter-plugins-dependencies
/client/.packages
/client/linux/flutter/ephemeral/
/client/windows/flutter/ephemeral/
/client/macos/Flutter/ephemeral/
/client/ios/Flutter/flutter_export_environment.sh
/client/ios/Pods/
/client/android/.gradle/
/client/android/local.properties
/client/android/key.properties
*.iml

# Deployment --
/deploy/server/web/
# Generated by ./deploy.sh web-build; the Server image COPYs it from disk.
---------------------------------------------------------------
# The Worker image needs a SatDump package that is too large to commit and is
# not ours to redistribute; see deploy/README.md.
/deploy/worker/satdump.deb
/deploy/worker/*.deb
/deploy/worker/*.rpm

# Runtime data ---------------------------------------------------------------
# Recordings, worker state and uploaded pipelines. The development environment
# writes under ~/.local/share/aagasa, not here, but a stray run should not be
# committed either.
/data/
/recordings/
/run/
*.log
*.sqlite
*.sqlite3
*.db-wal
*.db-shm

# Reference implementation ---------------------------------------------------
# Its own git repository with its own history. Kept on disk as read-only
# input; not tracked here.
/REFERENCE/project_dia/

# Editors and operating systems ----------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

